{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounting-app-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "account_id": "d6786b45957d1451fc64df81eaf19462",
  // ここは「デプロイ時に適用される本番の値」。ローカル開発では .dev.vars の
  // 同名キーが優先されるため、wrangler dev では localhost の値が使われる。
  // assets でフロントも同じWorkerから配信するので、3つとも同一オリジンになる。
  "vars": {
    "WEB_ORIGIN": "https://accounting-app-server.koki-tominaga.workers.dev",
    "BETTER_AUTH_URL": "https://accounting-app-server.koki-tominaga.workers.dev",
    "EMAIL_FROM_ADDRESS": "no-reply@koki-tominaga.cc"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first":[
      "/api/*",
      "/auth/*"
    ]
  },
  "d1_databases": [
    { 
      "binding": "DB",
      "database_name": "accounting-app-d1",
      "database_id": "11ee53d7-ae23-4061-bad7-ba4e2a09c8de",
      "migrations_dir": "./drizzle",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "accounting-app-r2"
    }
  ],
  "send_email": [
    {
      "name":"EMAIL",
      "remote": true
    }
  ]
}
